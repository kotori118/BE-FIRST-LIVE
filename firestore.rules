rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'xBt1XGXQjUg0UI9opk18Y76bucQ2'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Connection test only. No live records, attendance or song data are opened.
    match /diagnostics/firestoreConnection {
      allow get: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasAll(['message', 'checkedAt'])
        && request.resource.data.keys().hasOnly(['message', 'checkedAt'])
        && request.resource.data.message == 'BE-FIRST-LIVE connection test'
        && request.resource.data.checkedAt == request.time;
      allow delete: if isOwner();
    }

    // GAS writes with Google OAuth + IAM. Client apps cannot modify the catalog.
    match /universeSongs/{songId} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /syncStatus/current {
      allow get: if isOwner();
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
