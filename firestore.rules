rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'xBt1XGXQjUg0UI9opk18Y76bucQ2'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Connection test only. No live records, attendance or song data are opened.
    match /diagnostics/firestoreConnection {
      allow get: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasAll(['message', 'checkedAt'])
        && request.resource.data.keys().hasOnly(['message', 'checkedAt'])
        && request.resource.data.message == 'BE-FIRST-LIVE connection test'
        && request.resource.data.checkedAt == request.time;
      allow delete: if isOwner();
    }

    // GAS writes with Google OAuth + IAM. Client apps cannot modify the catalog.
    match /universeSongs/{songId} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /syncStatus/current {
      allow get: if isOwner();
      allow write: if false;
    }
    match /syncRequests/current {
      allow get: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['requestId','requestedAt','state'])
        && request.resource.data.requestId is string
        && request.resource.data.requestId.matches('^[a-f0-9-]{36}$')
        && request.resource.data.requestedAt == request.time
        && request.resource.data.state == 'PENDING';
    }
    match /users/{uid}/control/state {
      allow read: if isOwner() && uid == request.auth.uid;
      allow create: if isOwner() && uid == request.auth.uid
        && request.resource.data.revision == 0
        && request.resource.data.previousDatasetId == null
        && getAfter(/databases/$(database)/documents/users/$(uid)/datasets/$(request.resource.data.activeDatasetId)).data.ready == true;
      allow update: if isOwner() && uid == request.auth.uid
        && request.resource.data.revision == resource.data.revision + 1
        && getAfter(/databases/$(database)/documents/users/$(uid)/datasets/$(request.resource.data.activeDatasetId)).data.ready == true;
    }
    match /users/{uid}/datasets/{datasetId} {
      allow read: if isOwner() && uid == request.auth.uid;
      allow create: if isOwner() && uid == request.auth.uid
        && request.resource.data.ready is bool
        && request.resource.data.schemaVersion == 1;
      allow update: if isOwner() && uid == request.auth.uid && resource.data.ready == false && request.resource.data.ready == true && request.resource.data.schemaVersion == 1;
      match /{kind}/{entityId} {
        function editable() {
          return isOwner() && uid == request.auth.uid
            && kind in ['tours','shows','templates','overrides','directEntries','entryFacts','localSongs','songMetadata','releases','releaseTracks','attendance']
            && get(/databases/$(database)/documents/users/$(uid)/control/state).data.activeDatasetId == datasetId
            && getAfter(/databases/$(database)/documents/users/$(uid)/control/state).data.revision == get(/databases/$(database)/documents/users/$(uid)/control/state).data.revision + 1;
        }
        allow read: if isOwner() && uid == request.auth.uid;
        allow create: if isOwner() && uid == request.auth.uid && kind in ['tours','shows','templates','overrides','directEntries','entryFacts','localSongs','songMetadata','releases','releaseTracks','attendance'] && request.resource.data.id == entityId && request.resource.data.revision is int && ((editable() && request.resource.data.revision == 0) || get(/databases/$(database)/documents/users/$(uid)/datasets/$(datasetId)).data.ready == false);
        allow update: if editable() && request.resource.data.id == entityId && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if editable();
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
