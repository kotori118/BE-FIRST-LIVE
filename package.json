{
  "name": "be-first-live-connection-test",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-live-connection 'node --test --test-concurrency=1 tests/*.test.mjs'",
    "build": "tsc --noEmit && vite build",
    "test:body": "vitest run --config vitest.body.config.ts",
    "dev": "vite --host 0.0.0.0",
    "build:preview": "VITE_PREVIEW=true vite build --outDir app-preview"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^14.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
